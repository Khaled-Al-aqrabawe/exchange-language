# Copy this file to `.env` and fill in real values before running
# `docker compose up` or deploying to Coolify.

# --- Database ---
POSTGRES_DB=language_partner
POSTGRES_USER=language_partner
POSTGRES_PASSWORD=change-me

# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma-separated. Must include the backend's public domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
# Comma-separated. Must include the frontend's public URL (with scheme).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com
# Comma-separated. Must include the backend's own public URL (with scheme) —
# required for the Django admin login to work behind HTTPS.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://api.yourdomain.com

# --- Frontend (build-time) ---
# The backend's public URL, no trailing slash. Baked into the JS bundle at
# build time, so this must be set correctly *before* building the image.
VITE_API_URL=http://localhost:8000
